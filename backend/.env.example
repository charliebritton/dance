# Copy to backend/.env for local development (or the repo root .env used by docker compose in production).
# Everything is optional for a local run; Claude features stay off without an API key.

# Claude (Claude Platform API key: https://platform.claude.com → API keys). Leave empty to switch Claude off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# who may call Claude: "admin" only, or "all" members with a daily limit each
AI_ACCESS=admin
AI_DAILY_LIMIT=10

# Long random string (production refuses to start without one):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# true behind HTTPS
SECURE_COOKIES=false

# Where the site is served. Passkeys need RP_ID = the bare domain and ORIGIN = scheme + host (+ port).
BASE_PATH=
RP_ID=localhost
ORIGIN=http://localhost:8021

# Optional
RENDER_TOKEN=          # shared secret for render/worker.mjs uploads
ENV_LABEL=             # e.g. "dev": striped header bar with a DEV tag; empty in production
WHISPER_MODEL=base     # lesson transcription: tiny | base | small
